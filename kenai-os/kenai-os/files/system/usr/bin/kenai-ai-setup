#!/usr/bin/bash
# One-time setup for Kenai AI. Safe to re-run.
export PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
bold=$'\e[1m'; red=$'\e[38;2;255;90;72m'; dim=$'\e[2m'; off=$'\e[0m'
step() { echo; echo "${red}${bold}▸ $*${off}"; }

echo "${bold}Kenai AI setup${off}"
echo "${dim}Installs Claude Code and Gemini CLI, plus Odysseus if you want it.${off}"

step "Claude Code"
if command -v claude >/dev/null; then
  echo "Already installed."
else
  curl -fsSL https://claude.ai/install.sh | bash
fi

step "Gemini CLI"
if command -v gemini >/dev/null; then
  echo "Already installed."
elif command -v brew >/dev/null; then
  brew install gemini-cli
else
  echo "Homebrew isn't available, so Gemini CLI was skipped."
  echo "Install Homebrew from https://brew.sh, then run kenai-ai-setup again."
fi

step "Kenai context for the assistants"
mkdir -p "$HOME/.claude" "$HOME/.gemini"
[[ -f "$HOME/.claude/CLAUDE.md" ]] || cp /usr/share/kenai/CLAUDE.md "$HOME/.claude/CLAUDE.md"
[[ -f "$HOME/.gemini/GEMINI.md" ]] || cp /usr/share/kenai/CLAUDE.md "$HOME/.gemini/GEMINI.md"
echo "Both assistants now know how Kenai OS works and to back up before changing anything."

step "Odysseus (local AI on your GPU)"
read -r -p "Install Odysseus now? It downloads several GB. [y/N] " ans
if [[ "${ans,,}" == y* ]]; then
  /usr/bin/kenai-odysseus install
else
  echo "Skipped. Install later with: kenai-odysseus install"
fi

echo
echo "${bold}Next:${off} sign in once to each assistant."
echo "  Claude: type ${bold}claude${off} and follow the browser sign-in (needs a Claude Pro/Max plan or API key)."
echo "  Gemini: type ${bold}gemini${off} and choose 'Login with Google'."
echo "After that, open Kenai AI from the dock or with Super+Space."
exec bash -l
