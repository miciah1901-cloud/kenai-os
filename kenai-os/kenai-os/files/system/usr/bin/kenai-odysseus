#!/usr/bin/bash
# Odysseus (open-source AI workspace) running locally, with models served by
# Ollama on your GPU. Everything stays on 127.0.0.1 — nothing is exposed to
# your network.
#   kenai-odysseus install | start | stop | status | open | update | logs
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

DIR="$HOME/.local/share/kenai/odysseus"
UNIT="kenai-odysseus.service"
OLLAMA_DIR="$HOME/.local/share/kenai/ollama"
OLLAMA_UNIT="kenai-ollama.service"
PORT=7000
URL="http://127.0.0.1:$PORT"
MODEL="${KENAI_MODEL:-qwen3:14b}"     # fits a 16 GB GPU; override with KENAI_MODEL=...
FALLBACK_MODEL="llama3.1:8b"

write_units() {
  mkdir -p "$HOME/.config/systemd/user"
  cat > "$HOME/.config/systemd/user/$OLLAMA_UNIT" <<EOF
[Unit]
Description=Ollama model server (Kenai OS)

[Service]
Environment=OLLAMA_HOST=127.0.0.1:11434
ExecStart=$OLLAMA_DIR/bin/ollama serve
Restart=on-failure

[Install]
WantedBy=default.target
EOF
  cat > "$HOME/.config/systemd/user/$UNIT" <<EOF
[Unit]
Description=Odysseus AI workspace (Kenai OS)
Wants=$OLLAMA_UNIT
After=$OLLAMA_UNIT

[Service]
WorkingDirectory=$DIR
ExecStart=$DIR/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port $PORT
Restart=on-failure

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
}

case "${1:-}" in
  install)
    echo "▸ Ollama (runs the AI models on your GPU; installed in your home folder)"
    if [[ ! -x "$OLLAMA_DIR/bin/ollama" ]]; then
      mkdir -p "$OLLAMA_DIR"
      curl -fsSL https://ollama.com/download/ollama-linux-amd64.tar.zst | tar --zstd -x -C "$OLLAMA_DIR" \
        || { echo "Ollama download failed."; exit 1; }
      mkdir -p "$HOME/.local/bin" && ln -sf "$OLLAMA_DIR/bin/ollama" "$HOME/.local/bin/ollama"
    else echo "Already installed."; fi

    echo "▸ uv (Python toolchain)"
    command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/install.sh | sh

    echo "▸ Odysseus"
    if [[ -d "$DIR/.git" ]]; then git -C "$DIR" pull --ff-only
    else mkdir -p "$(dirname "$DIR")" && git clone -b main https://github.com/odysseus-dev/odysseus.git "$DIR"; fi
    cd "$DIR" || exit 1
    uv venv --python 3.12 .venv
    uv pip install --python .venv/bin/python -r requirements.txt || { echo "Dependency install failed."; exit 1; }

    echo "▸ First-time setup (note the admin password it prints)"
    .venv/bin/python setup.py

    write_units
    systemctl --user enable --now "$OLLAMA_UNIT" "$UNIT"
    sleep 3

    echo "▸ Downloading a starter model: $MODEL"
    ollama pull "$MODEL" || ollama pull "$FALLBACK_MODEL"

    cat <<EOF

Odysseus is running at $URL
  1. Log in as 'admin' with the password printed above, then change it in Settings.
  2. Settings → add a model endpoint:  http://127.0.0.1:11434/v1  (Ollama)
  3. Pick the model you just downloaded and start chatting.
EOF
    ;;
  start)  systemctl --user start "$OLLAMA_UNIT" "$UNIT" ;;
  stop)   systemctl --user stop "$UNIT" "$OLLAMA_UNIT" ;;
  status) systemctl --user status "$OLLAMA_UNIT" "$UNIT" --no-pager ;;
  logs)   journalctl --user -u "$UNIT" -u "$OLLAMA_UNIT" -n 100 --no-pager ;;
  open)
    systemctl --user start "$OLLAMA_UNIT" "$UNIT"
    for _ in $(seq 1 20); do curl -fs "$URL" >/dev/null 2>&1 && break; sleep 0.5; done
    xdg-open "$URL" >/dev/null 2>&1 &
    ;;
  update)
    git -C "$DIR" pull --ff-only && \
      uv pip install --python "$DIR/.venv/bin/python" -r "$DIR/requirements.txt" && \
      systemctl --user restart "$UNIT"
    ;;
  *) echo "Usage: kenai-odysseus install|start|stop|status|open|update|logs"; exit 1 ;;
esac
