{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/kenai/bear.txt",
    "color": { "1": "38;2;255;90;72", "2": "38;2;255;241;236" },
    "padding": { "right": 3 }
  },
  "display": { "separator": "  ", "color": { "keys": "38;2;255;90;72" } },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "OS     " },
    { "type": "kernel", "key": "Kernel " },
    { "type": "de", "key": "DE     " },
    { "type": "cpu", "key": "CPU    " },
    { "type": "gpu", "key": "GPU    " },
    { "type": "display", "key": "Display" },
    { "type": "memory", "key": "Memory " },
    { "type": "disk", "key": "Disk   " },
    "break", "colors"
  ]
}
