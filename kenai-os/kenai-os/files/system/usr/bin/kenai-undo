#!/usr/bin/bash
# Restore desktop settings from a Kenai backup.
# Usage: kenai-undo            restore the newest backup
#        kenai-undo --list     show backups
#        kenai-undo <folder>   restore a specific one
set -uo pipefail
root="$HOME/.config/kenai-backups"

if [[ "${1:-}" == "--list" ]]; then
  ls -1t "$root" 2>/dev/null || echo "No backups yet."
  exit 0
fi

if [[ -n "${1:-}" ]]; then
  src="$root/$(basename "$1")"
else
  # newest backup that isn't the safety copy made by a previous undo
  src=$(ls -1dt "$root"/*/ 2>/dev/null | grep -v -- '-before-undo/$' | head -n1)
fi
src=${src%/}
[[ -d "$src" ]] || { echo "No backup found."; exit 1; }

/usr/bin/kenai-backup "before-undo" >/dev/null

# Stop the shell first, or it rewrites the layout file on exit and undoes the restore.
systemctl --user stop plasma-plasmashell 2>/dev/null || kquitapp6 plasmashell 2>/dev/null
sleep 1
cp -a "$src"/. "$HOME/.config/"
systemctl --user start plasma-plasmashell 2>/dev/null || (plasmashell >/dev/null 2>&1 &)

QDBUS=$(command -v qdbus6 || command -v qdbus-qt6 || command -v qdbus)
[[ -n "$QDBUS" ]] && "$QDBUS" org.kde.KWin /KWin reconfigure >/dev/null 2>&1
echo "Restored $(basename "$src")"
